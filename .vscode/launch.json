// A launch configuration that runs the extension from `dist/extension.js`.
//
// There is deliberately no preLaunchTask: this machine has no global node/npm,
// so the npm task provider cannot build. Run `pnpm run package` (or the bundled
// node + `node node_modules/webpack/bin/webpack.js`) before launching if you
// changed anything under `src/`.
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		}
	]
}
