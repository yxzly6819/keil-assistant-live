{
    "name": "keil-assistant",
    "displayName": "Keil Assistant",
    "description": "Load, browse, build and flash Keil uVision 5 projects (.uvproj / .uvprojx) inside VS Code.",
    "version": "2.0.0",
    "publisher": "cl",
    "author": {
        "name": "cl",
        "email": "2584456014@qq.com"
    },
    "keywords": [
        "keil",
        "mdk",
        "c51",
        "8051",
        "stm32",
        "uvision"
    ],
    "license": "MIT",
    "homepage": "https://github.com/github0null/keil-assistant",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Other"
    ],
    "icon": "res/icons/icon.png",
    "main": "./dist/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/github0null/keil-assistant.git"
    },
    "bugs": {
        "url": "https://github.com/github0null/keil-assistant/issues",
        "email": "2584456014@qq.com"
    },
    "activationEvents": [
        "onView:project",
        "onCommand:explorer.open",
        "onCommand:project.build",
        "onCommand:project.rebuild",
        "onCommand:project.download",
        "onCommand:project.switch",
        "onCommand:project.active",
        "onCommand:project.close",
        "onCommand:project.openLog",
        "onCommand:item.copyValue",
        "workspaceContains:**/*.uvprojx",
        "workspaceContains:**/*.uvproj"
    ],
    "contributes": {
        "configuration": [
            {
                "title": "Keil Assistant",
                "properties": {
                    "KeilAssistant.C51.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "Absolute path of the C51 `UV4.exe` (e.g. `C:\\Keil_v5\\UV4\\UV4.exe`).",
                        "default": null
                    },
                    "KeilAssistant.MDK.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "Absolute path of the MDK-ARM `UV4.exe` (e.g. `C:\\Keil_v5\\UV4\\UV4.exe`).",
                        "default": null
                    },
                    "KeilAssistant.Project.ExcludeList": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "scope": "resource",
                        "markdownDescription": "Project file names that are never loaded automatically (compared with the file name only).",
                        "default": [
                            "template.uvproj",
                            "template.uvprojx"
                        ]
                    },
                    "KeilAssistant.Project.FileLocationList": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "scope": "resource",
                        "markdownDescription": "Extra project files to load. Each entry is a path or a glob, variables such as `${workspaceFolder}` are expanded.",
                        "default": []
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "explorer.open",
                "title": "Open keil uVision project",
                "category": "Keil Assistant",
                "icon": {
                    "light": "./res/icons/ClassAdded_16x.svg",
                    "dark": "./res/icons/ClassAdded_16x.svg"
                }
            },
            {
                "command": "project.switch",
                "title": "Switch Target",
                "category": "Keil Assistant",
                "icon": {
                    "light": "./res/icons/SwitchSourceOrTarget_16x.svg",
                    "dark": "./res/icons/SwitchSourceOrTarget_16x.svg"
                }
            },
            {
                "command": "project.active",
                "title": "Active Project",
                "category": "Keil Assistant"
            },
            {
                "command": "project.close",
                "title": "Close Project",
                "category": "Keil Assistant",
                "icon": {
                    "light": "./res/icons/StatusOffline_16x.svg",
                    "dark": "./res/icons/StatusOffline_16x.svg"
                }
            },
            {
                "command": "project.build",
                "title": "Build",
                "category": "Keil Assistant",
                "icon": {
                    "light": "./res/icons/BuildSelection_16x.svg",
                    "dark": "./res/icons/BuildSelection_16x.svg"
                }
            },
            {
                "command": "project.rebuild",
                "title": "Rebuild",
                "category": "Keil Assistant",
                "icon": {
                    "light": "./res/icons/BuildSolution_16x.svg",
                    "dark": "./res/icons/BuildSolution_16x.svg"
                }
            },
            {
                "command": "project.download",
                "title": "Download To Device",
                "category": "Keil Assistant",
                "icon": {
                    "light": "./res/icons/TransferDownload_16x.svg",
                    "dark": "./res/icons/TransferDownload_16x.svg"
                }
            },
            {
                "command": "project.openLog",
                "title": "Open Log",
                "category": "Keil Assistant"
            },
            {
                "command": "item.copyValue",
                "title": "Copy Item Value",
                "category": "Keil Assistant",
                "icon": {
                    "light": "./res/icons/CopyToClipboard_16x.svg",
                    "dark": "./res/icons/CopyToClipboard_16x.svg"
                }
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "project.build",
                    "group": "navigation@1",
                    "when": "keil.hasProject"
                },
                {
                    "command": "project.rebuild",
                    "group": "navigation@2",
                    "when": "keil.hasProject"
                },
                {
                    "command": "project.download",
                    "group": "navigation@3",
                    "when": "keil.hasProject"
                }
            ],
            "view/title": [
                {
                    "command": "explorer.open",
                    "group": "navigation",
                    "when": "view == project"
                }
            ],
            "view/item/context": [
                {
                    "command": "project.close",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.active",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.openLog",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.switch",
                    "group": "inline",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.build",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.download",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "item.copyValue",
                    "group": "inline",
                    "when": "viewItem == Source"
                }
            ]
        },
        "keybindings": [
            {
                "command": "project.build",
                "key": "f7"
            },
            {
                "command": "project.rebuild",
                "key": "ctrl+alt+f7"
            },
            {
                "command": "project.download",
                "key": "ctrl+alt+d"
            }
        ],
        "snippets": [
            {
                "language": "a51",
                "path": "./syntaxes/a51.snippets.json"
            }
        ],
        "languages": [
            {
                "id": "a51",
                "aliases": [
                    "A51",
                    "8051 Assembly"
                ],
                "extensions": [
                    ".a51",
                    ".A51"
                ],
                "filenamePatterns": [
                    "**/*.a51",
                    "**/*.A51"
                ],
                "configuration": "./syntaxes/a51.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "a51",
                "scopeName": "source.asm.a51",
                "path": "./syntaxes/a51.tmLanguage.json"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "project",
                    "name": "Keil uVision Project"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "webpack --mode production",
        "package": "webpack --mode production",
        "compile": "tsc -p .",
        "check": "tsc -p . --noEmit",
        "watch": "tsc -p . --watch",
        "test": "tsc -p . && node ./out/test/index.js"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^20.14.10",
        "@types/vscode": "~1.85.0",
        "@types/xml2js": "^0.4.14",
        "ts-loader": "^9.5.1",
        "typescript": "^5.5.4",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.4",
        "xml2js": "^0.6.2"
    }
}
