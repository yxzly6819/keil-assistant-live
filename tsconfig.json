{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "lib": [
            "ES2021"
        ],
        "outDir": "out",
        "rootDir": ".",
        "strict": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": [
        "src",
        "test"
    ],
    "exclude": [
        "node_modules",
        "out",
        "dist"
    ]
}
